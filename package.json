{
  "name": "mitt",
  "version": "4.0.0",
  "description": "Tiny 200b functional Event Emitter / pubsub.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc test/test-types-compilation.ts --noEmit --strict --moduleResolution node --target ESNext",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "repository": "ahmadawais/mitt",
  "keywords": [
    "events",
    "eventemitter",
    "emitter",
    "pubsub"
  ],
  "homepage": "https://github.com/ahmadawais/mitt",
  "author": "Ahmad Awais <me@AhmadAwais.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.30.1"
}
