{
	"compileOnSave": false,
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"declaration": true,
		"moduleResolution": "node",
		"module": "ESNext",
		"target": "ESNext",
		"skipLibCheck": true,
		"esModuleInterop": true
	},
	"include": [
		"src/*.ts",
		"test/*.ts"
	]
}
